{
    "name": "joomla/router",
    "type": "joomla-package",
    "description": "Joomla Router Package",
    "keywords": ["joomla", "framework", "router"],
    "homepage": "https://github.com/joomla-framework/router",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3.0"
    },
    "require-dev": {
        "opis/closure": "^4.3.1",
        "joomla/console": "^4.0",
        "phpunit/phpunit": "^12.5 || ^13.0",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1.17",
        "phpstan/phpstan-deprecation-rules": "^2.0.3"
    },
    "suggest": {
        "opis/closure": "If you use Closure based controllers and want to be able to serialize the router, please install opis/closure",
        "joomla/console": "If you want to use the DebugRouterCommand class, please install joomla/console"
    },
    "autoload": {
        "psr-4": {
            "Joomla\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joomla\\Router\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "dev"
}
